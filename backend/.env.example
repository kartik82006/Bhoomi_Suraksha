# Backend Environment Variables
# Copy to .env and fill in values for local development
# In production (Railway), set these as environment variables in the service dashboard

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
BACKEND_HOST=0.0.0.0

# ── Database (PostgreSQL + PostGIS) ────────────────────────
# Railway provides this automatically when you add a PostgreSQL service
DATABASE_URL=postgresql://bhoomi:bhoomi@localhost:5432/bhoomi_suraksha

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Local: http://localhost:5173
# Production: https://your-frontend-domain.railway.app
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
PASSWORD_HASH_ALGO=argon2

# ── ML & Scoring Config ───────────────────────────────────
# Paths relative to backend/ directory (copied into Docker image)
AHP_WEIGHTS_FILE=./config/ahp_weights.yaml
ENABLE_ML_SUSCEPTIBILITY=true
ML_MODEL_PATH=./models/susceptibility.onnx
ML_BLEND_WEIGHT=0.6

# ── Optional: Translation (Sarvam AI) ──────────────────────
SARVAM_API_KEY=

# ── Optional: Cache (Redis) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false

# ── Optional: Data paths (for local development only) ──────
# In production, processed data comes from database, not files
PROCESSED_DATA_PATH=./data/processed
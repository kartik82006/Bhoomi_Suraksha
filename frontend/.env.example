# Frontend Environment Variables
# Copy to .env and fill in values for local development
# In production (Railway), set VITE_API_BASE_URL in the frontend service dashboard

# API base URL - MUST be set for production builds
# Local: http://localhost:8000/api
# Production: https://your-backend-domain.railway.app/api
VITE_API_BASE_URL=http://localhost:8000/api
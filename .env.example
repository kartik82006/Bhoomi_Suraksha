# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL + PostGIS) ────────────────────────
DATABASE_URL=postgresql://bhoomi:bhoomi@localhost:5432/bhoomi_suraksha
POSTGIS_ENABLED=true

# ── Cache (optional) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
PASSWORD_HASH_ALGO=argon2

# ── Data sources (paths and/or API keys) ──────────────────
BHUVAN_API_KEY=                      # ISRO Bhuvan token (NOTE: Bhuvan tokens expire ~daily)
BHUVAN_WMS_BASE=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms/get
BHUVAN_LAYER=                        # exact Bhuvan layer name provisioned for your token
BHOONIDHI_API_KEY=
IMD_DATA_PATH=./data/raw/imd
DEM_DATA_PATH=./data/raw/dem
LANDSLIDE_ATLAS_PATH=./data/raw/nrsc_landslide_atlas
BHUKOSH_DATA_PATH=./data/raw/bhukosh
CENSUS_DATA_PATH=./data/raw/census
GHSL_DATA_PATH=./data/raw/ghsl
NDEM_DATA_PATH=./data/raw/ndem
PROCESSED_DATA_PATH=./data/processed
ANALYSIS_CRS=EPSG:7755

# ── Scoring config ────────────────────────────────────────
AHP_WEIGHTS_FILE=./config/ahp_weights.yaml
ENABLE_ML_SUSCEPTIBILITY=true        # XGBoost model trained & exported (models/susceptibility.onnx)
ML_MODEL_PATH=./models/susceptibility.onnx
ML_BLEND_WEIGHT=0.6
ANALYSIS_GRID_RES_M=30

# ── Map / tiles (optional) ────────────────────────────────
TILE_SERVER_URL=http://localhost:7800
BASEMAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ── Translation (Sarvam AI) ──────────────────────────────
# Required for the Hindi toggle. Set this in your local .env only.
SARVAM_API_KEY=
